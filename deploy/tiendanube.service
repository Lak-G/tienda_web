# /etc/systemd/system/tiendanube.service
[Unit]
Description=TiendaNube (ASP.NET Core 10)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tiendanube
Group=tiendanube
WorkingDirectory=/opt/tiendanube/app
ExecStart=/opt/tiendanube/app/TiendaNube.Web
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
SyslogIdentifier=tiendanube

# Configuración sin secretos
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=DOTNET_NOLOGO=1
Environment=Almacenamiento__Proveedor=S3
Environment=S3__Bucket=tiendanube-bucket
Environment=S3__Region=us-east-2
Environment=DataProtection__RutaClaves=/var/lib/tiendanube/claves

# Secretos (cadena de conexión a RDS y admin semilla): root:tiendanube, permisos 640, fuera del repositorio
EnvironmentFile=/etc/tiendanube/tiendanube.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
