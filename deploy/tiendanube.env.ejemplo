# Plantilla de /etc/tiendanube/tiendanube.env (root:tiendanube, permisos 640).
# El archivo real NUNCA se sube al repositorio. Valores entre comillas dobles.
ConnectionStrings__Default="Host=<endpoint-rds>.us-east-2.rds.amazonaws.com;Port=5432;Database=tiendanube;Username=tienda;Password=<contraseña>;SSL Mode=Require"
AdminSemilla__Usuario="admin"
AdminSemilla__Contrasena="<contraseña-del-admin-inicial>"
