@inject TiendaNube.Web.Services.ICarritoService CarritoService
@{
    var articulosEnCarrito = CarritoService.ContarArticulos();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TiendaNube</title>
    <link rel="preload" href="~/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="Salto_Contenido" href="#Contenido">Saltar al contenido</a>

    <header class="Encabezado">
        <nav class="Nav_Princ" aria-label="Principal">
            <a class="Nav_Marca" asp-page="/Index">TiendaNube</a>
            <ul class="Nav_Lista">
                <li><a asp-page="/Index">Catálogo</a></li>
                <li>
                    <a asp-page="/Carrito">
                        Carrito
                        @if (articulosEnCarrito > 0)
                        {
                            <span class="Contador_Carrito">@articulosEnCarrito<span class="Solo_Lector"> artículos</span></span>
                        }
                    </a>
                </li>
                <li><a asp-page="/Admin/Index">Admin</a></li>
            </ul>
        </nav>
    </header>

    <main id="Contenido" class="Cont_Principal" tabindex="-1">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <p class="Alerta Alerta_Exito" role="status">@mensaje</p>
        }
        @if (TempData["Error"] is string error)
        {
            <p class="Alerta Alerta_Error" role="alert">@error</p>
        }
        @RenderBody()
    </main>

    <footer class="Pie">
        <span>&copy; @DateTime.Now.Year TiendaNube</span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
