@page "{id:int}"
@model TiendaNube.Web.Pages.Admin.Productos.EditarModel
@{
    ViewData["Title"] = $"Editar {Model.Producto.Nombre}";
}

<h1>Editar producto</h1>

<form method="post" enctype="multipart/form-data" class="Form_Admin Form_Producto">
    <div asp-validation-summary="ModelOnly" class="Alerta Alerta_Error" role="alert"></div>

    <partial name="_FormularioProducto" for="Producto" />

    <div class="Acciones_Form">
        <button type="submit" class="Btn_Princ">Guardar cambios</button>
        <a asp-page="Index" class="Btn_Sec">Cancelar</a>
        <a asp-page="Eliminar" asp-route-id="@Model.Producto.Id" class="Enlace_Peligro">Eliminar producto</a>
    </div>
</form>
